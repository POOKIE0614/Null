PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
MAX_FILE_SIZE_MB=100
FRAGMENTS_TOTAL=10
FRAGMENTS_THRESHOLD=6
CHUNK_SIZE_KB=64
DATA_DIR=./src/data

# --- MOCK FLAGS ---
# Set to 'mock' to use local mocks, 'real' to use live services
STORY_PROVIDER=mock
ARWEAVE_PROVIDER=mock

# --- REAL STORY PROTOCOL (fill when ready) ---
# STORY_PRIVATE_KEY=your_64_char_hex_key
# STORY_RPC_URL=https://aeneid.storyrpc.io
